# Content Intelligence environment.
# Copy to a private env file. Do not commit real values.
#
# Build-time (inlined into the client bundle, safe to be public):
#   NEXT_PUBLIC_BRAND_NAME
#   NEXT_PUBLIC_APP_URL
# Everything else is a runtime secret or runtime setting. Do not put secrets in NEXT_PUBLIC_*.

# Runtime — Postgres (local compose service `db`, host port 5433)
DATABASE_URL=postgres://content_intel:change-me@127.0.0.1:5433/content_intel
POSTGRES_USER=content_intel
POSTGRES_DB=content_intel
POSTGRES_PASSWORD=change-me

# Runtime — first admin, created on boot if missing. Set ADMIN_RESET_PASSWORD=1 to overwrite.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=

# Runtime — auth gate. open = auto admin session (no login form); password = email/password form.
# Default open for single-admin V0.1 on a private URL. Set password to re-enable LOGIN.txt credentials.
AUTH_MODE=open

# Runtime secrets
SESSION_SECRET=
WORKER_SECRET=

# Runtime — OpenAI-compatible gateway. Do not call generativelanguage.googleapis.com.
# AI_MODEL is required. Current model is antigravity/gemini-3.8-flash-medium.
# Do not set Gemini 2.5 or any older Gemini model.
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://127.0.0.1:8989/v1
AI_API_KEY=
AI_MODEL=antigravity/gemini-3.8-flash-medium
AI_BATCH_SIZE=8
AI_ANALYSIS_LIMIT=30

# Runtime — scraper selection: apify | tikhub | youtube | auto
SCRAPER_PROVIDER=apify
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_MAX_RESULTS_PER_RUN=30
APIFY_RESULTS_PER_KEYWORD=10
APIFY_MAX_KEYWORDS_PER_RUN=3

# TikHub is off the automatic fallback chain unless TIKHUB_AUTO_FALLBACK=1.
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_MAX_REQUESTS_PER_RUN=2
TIKHUB_RESULTS_PER_REQUEST=20
TIKHUB_REGION=US
TIKHUB_AUTO_FALLBACK=

# YouTube Shorts (yt-dlp). Default off: opening youtube.com/results can hang or kill the scraper process on this host.
YOUTUBE_PROVIDER_ENABLED=0

# Runtime — worker
RESEARCH_WORKER=
RESEARCH_TICK_MS=5000
PORT=3100
HOSTNAME=127.0.0.1

# Build-time public branding
NEXT_PUBLIC_BRAND_NAME=Content Intelligence
NEXT_PUBLIC_APP_URL=https://research.logos144000.com
AI_MODEL_INTEL=antigravity/gemini-3.8-flash-high
